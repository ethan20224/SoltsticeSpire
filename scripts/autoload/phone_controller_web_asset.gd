fore {\n    content: \"\";\n    position: absolute;\n    inset: 10px;\n    border-radius: 50%;\n    border: 1px dashed oklch(0.90 0.03 80 / 0.16);\n    pointer-events: none;\n  }\n\n  .stick-well.active {\n    border-color: var(--accent);\n    box-shadow:\n      inset 0 6px 18px oklch(0.05 0.01 55 / 0.85),\n      0 0 20px var(--accent-glow);\n  }\n\n  .stick-well.sprinting {\n    border-color: var(--ink-primary);\n    box-shadow:\n      inset 0 0 20px var(--accent-glow),\n      0 0 26px var(--accent-glow);\n  }\n\n  .stick-axis-cross {\n    position: absolute;\n    inset: 22px;\n    pointer-events: none;\n    opacity: 0.22;\n  }\n\n  .stick-axis-cross::before,\n  .stick-axis-cross::after {\n    content: \"\";\n    position: absolute;\n    background: var(--ink-secondary);\n  }\n  .stick-axis-cross::before {\n    left: 50%; top: 0; bottom: 0; width: 1px; transform: translateX(-0.5px);\n  }\n  .stick-axis-cross::after {\n    top: 50%; left: 0; right: 0; height: 1px; transform: translateY(-0.5px);\n  }\n\n  .stick-cap {\n    width: clamp(58px, 16.5dvh, 72px);\n    height: clamp(58px, 16.5dvh, 72px);\n    border-radius: 50%;\n    background:\n      radial-gradient(circle at 36% 32%, oklch(0.34 0.025 55), oklch(0.21 0.018 55) 70%, oklch(0.15 0.014 55) 100%);\n    border: 2px solid var(--border-bright);\n    box-shadow:\n      0 6px 14px oklch(0.04 0.01 55 / 0.78),\n      inset 0 2px 4px oklch(0.98 0.01 80 / 0.20);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    pointer-events: none;\n    will-change: transform;\n  }\n\n  .stick-cap-inner {\n    width: 66%;\n    height: 66%;\n    border-radius: 50%;\n    border: 1.5px solid oklch(0.95 0.02 80 / 0.22);\n    background: radial-gradient(circle at 50% 50%, oklch(0.18 0.016 55), oklch(0.24 0.02 55));\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 9px;\n    font-weight: 900;\n    color: var(--ink-secondary);\n    letter-spacing: 0.04em;\n  }\n\n  .stick-well.active .stick-cap {\n    border-color: var(--accent);\n  }\n\n  .stick-well.sprinting .stick-cap-inner {\n    color: var(--accent);\n    border-color: var(--accent);\n  }\n\n  .stick-badge {\n    position: absolute;\n    bottom: -5px;\n    padding: 2px 9px;\n    border-radius: 999px;\n    font-size: 10px;\n    font-weight: 800;\n    background: oklch(0.16 0.016 55 / 0.94);\n    border: 1px solid var(--border-rim);\n    color: var(--ink-secondary);\n    pointer-events: none;\n  }\n\n  .stick-well.sprinting .stick-badge {\n    background: var(--accent);\n    color: var(--ink-dark);\n    border-color: var(--ink-primary);\n  }\n\n  /* Explorer Quick-Swap Bar (1 Pip / 2 Koko / 3 Vesper) */\n  .explorer-bar {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 6px;\n    z-index: 4;\n  }\n\n  .explorer-chip {\n    min-block-size: 38px;\n    height: clamp(38px, 10dvh, 44px);\n    border-radius: 999px;\n    background: var(--surface-glass);\n    border: 1px solid var(--border-rim);\n    color: var(--ink-secondary);\n    font-weight: 800;\n    font-size: clamp(11px, 1.4dvw, 13px);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 5px;\n    transition: transform 110ms var(--ease-out-expo), background 140ms ease, color 140ms ease, border-color 140ms ease;\n  }\n\n  .explorer-chip .dot {\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n  }\n\n  .explorer-chip.active {\n    background: oklch(0.96 0.02 82);\n    color: var(--ink-dark);\n    border-color: oklch(0.78 0.04 75);\n    font-weight: 900;\n    box-shadow: 0 3px 10px oklch(0.05 0.01 55 / 0.4);\n  }\n\n  .explorer-chip:active {\n    transform: scale(0.95);\n  }\n\n  /* ================= CENTER WING: DUALSENSE TOUCHPAD + LIVE TELEMETRY ================= */\n  .wing-center {\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    gap: 8px;\n    height: 100%;\n    position: relative;\n  }\n\n  .utility-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 6px;\n  }\n\n  .pill-btn {\n    min-block-size: 38px;\n    height: 38px;\n    padding: 0 12px;\n    border-radius: 999px;\n    background: var(--surface-raised);\n    border: 1px solid var(--border-rim);\n    color: var(--ink-primary);\n    font-size: 11px;\n    font-weight: 800;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 5px;\n    transition: transform 110ms var(--ease-out-expo), background 120ms ease;\n  }\n\n  .pill-btn.pressed,\n  .pill-btn.active-toggle {\n    transform: scale(0.95);\n    background: var(--accent);\n    color: var(--ink-dark);\n    border-color: var(--ink-primary);\n  }\n\n  .status-capsule {\n    flex: 1;\n    height: 38px;\n    padding: 0 10px;\n    border-radius: 999px;\n    background: oklch(0.12 0.012 55 / 0.92);\n    border: 1px solid var(--border-rim);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 6px;\n    font-size: 11px;\n    font-weight: 800;\n    color: var(--ink-secondary);\n    white-space: nowrap;\n  }\n\n  .status-dot {\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    background: oklch(0.75 0.16 70);\n    box-shadow: 0 0 8px oklch(0.75 0.16 70);\n  }\n\n  .status-dot.connected {\n    background: var(--emerald-live);\n    box-shadow: 0 0 10px var(--emerald-live);\n  }\n\n  /* DualSense Central Touchpad with Glowing Character Lightbar Flanks */\n  .touchpad-shell {\n    flex: 1;\n    position: relative;\n    border-radius: 18px 18px 26px 26px;\n    background:\n      linear-gradient(180deg, oklch(0.19 0.02 55) 0%, oklch(0.14 0.015 55) 100%);\n    border: 1.5px solid var(--border-rim);\n    box-shadow:\n      inset 0 2px 8px oklch(0.96 0.02 80 / 0.08),\n      0 8px 24px oklch(0.04 0.01 55 / 0.65);\n    padding: 12px 14px;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    overflow: hidden;\n  }\n\n  /* Left & Right DualSense Lightbar Slits */\n  .touchpad-shell::before,\n  .touchpad-shell::after {\n    content: \"\";\n    position: absolute;\n    top: 12%;\n    bottom: 16%;\n    width: 3.5px;\n    border-radius: 999px;\n    background: var(--accent);\n    box-shadow: 0 0 14px var(--accent), 0 0 24px var(--accent-glow);\n    transition: background 240ms ease, box-shadow 240ms ease;\n  }\n  .touchpad-shell::before { left: 0; }\n  .touchpad-shell::after { right: 0; }\n\n  .tp-header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 6px;\n    pointer-events: none;\n  }\n\n  .realm-badge {\n    padding: 2px 9px;\n    border-radius: 999px;\n    background: var(--accent);\n    color: var(--ink-dark);\n    font-size: 10px;\n    font-weight: 900;\n    letter-spacing: 0.02em;\n  }\n\n  .realm-title {\n    font-size: 11px;\n    font-weight: 700;\n    color: var(--ink-secondary);\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n\n  .tp-altitude-block {\n    text-align: center;\n    pointer-events: none;\n    margin: 2px 0;\n  }\n\n  .tp-alt-row {\n    display: flex;\n    align-items: baseline;\n    justify-content: center;\n    gap: 5px;\n    font-variant-numeric: tabular-nums;\n  }\n\n  .tp-alt-val {\n    font-size: clamp(26px, 7.2dvh, 34px);\n    font-weight: 900;\n    color: var(--ink-primary);\n    line-height: 1;\n  }\n\n  .tp-alt-goal {\n    font-size: 12px;\n    font-weight: 700;\n    color: var(--ink-muted);\n  }\n\n  .tp-progress-track {\n    width: 100%;\n    height: 5px;\n    border-radius: 999px;\n    background: oklch(0.10 0.01 55 / 0.8);\n    margin-top: 6px;\n    overflow: hidden;\n  }\n\n  .tp-progress-fill {\n    height: 100%;\n    width: 0%;\n    border-radius: 999px;\n    background: var(--accent);\n    transition: width 150ms linear;\n  }\n\n  .tp-metrics {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    font-size: 11px;\n    font-weight: 800;\n    color: var(--ink-secondary);\n    font-variant-numeric: tabular-nums;\n    pointer-events: none;\n  }\n\n  .tp-metrics .shard-count {\n    color: var(--accent);\n  }\n\n  .tp-hint {\n    text-align: center;\n    font-size: 10px;\n    font-weight: 700;\n    color: var(--ink-muted);\n    pointer-events: none;\n  }\n\n  /* Context Overlay inside Touchpad for Title Screen / Pause Menu / Victory */\n  .tp-context-drawer {\n    position: absolute;\n    inset: 0;\n    background: oklch(0.14 0.016 55 / 0.96);\n    padding: 10px 12px;\n    display: none;\n    flex-direction: column;\n    justify-content: space-between;\n    gap: 6px;\n    z-index: 6;\n  }\n\n  .tp-context-drawer.visible {\n    display: flex;\n  }\n\n  .cta-primary {\n    width: 100%;\n    min-block-size: 44px;\n    flex: 1;\n    max-height: 54px;\n    border-radius: 999px;\n    background: var(--accent);\n    border: 1px solid oklch(0.96 0.04 85);\n    border-bottom: 3px solid oklch(0.58 0.14 68);\n    color: var(--ink-dark);\n    font-family: inherit;\n    font-size: 14px;\n    font-weight: 900;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    box-shadow: 0 4px 16px var(--accent-glow);\n  }\n\n  .cta-primary:active {\n    transform: scale(0.96);\n  }\n\n  .realm-mini-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 5px;\n  }\n\n  .realm-mini-btn {\n    min-block-size: 32px;\n    padding: 4px 2px;\n    border-radius: 10px;\n    background: var(--surface-raised);\n    border: 1px solid var(--border-rim);\n    color: var(--ink-primary);\n    font-family: inherit;\n    font-size: 10px;\n    font-weight: 800;\n    text-align: center;\n  }\n\n  .realm-mini-btn:active {\n    transform: scale(0.94);\n    background: var(--accent);\n    color: var(--ink-dark);\n  }\n\n  /* Bottom Speaker Grille + Mic Mute Accent */\n  .dualsense-grille {\n    height: 18px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n  }\n\n  .grille-dots {\n    display: flex;\n    gap: 4px;\n  }\n\n  .grille-dots span {\n    width: 3px;\n    height: 3px;\n    border-radius: 50%;\n    background: oklch(0.45 0.02 65 / 0.5);\n  }\n\n  .haptic-led {\n    width: 16px;\n    height: 4px;\n    border-radius: 999px;\n    background: var(--accent);\n    box-shadow: 0 0 8px var(--accent);\n  }\n\n  /* ================= RIGHT WING: DIAMOND ACTION CLUSTER + RIGHT CAMERA STICK ================= */\n  .wing-right {\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    height: 100%;\n    position: relative;\n  }\n\n  .right-deck-body {\n    flex: 1;\n    position: relative;\n    display: grid;\n    grid-template-columns: 0.92fr 1.18fr;\n    align-items: center;\n    gap: 4px;\n  }\n\n  /* Right Camera Analog Thumbstick (bottom-inner right, true DualSense position) */\n  .cam-stick-wrap {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: flex-end;\n    height: 100%;\n    padding-bottom: 4px;\n  }\n\n  .cam-stick-well {\n    width: clamp(104px, 29dvh, 126px);\n    height: clamp(104px, 29dvh, 126px);\n    border-radius: 50%;\n    background:\n      radial-gradient(circle at 50% 50%, oklch(0.10 0.01 55) 0%, oklch(0.15 0.016 55) 70%, oklch(0.20 0.02 55) 100%);\n    border: 2px solid var(--border-rim);\n    box-shadow: inset 0 5px 14px oklch(0.05 0.01 55 / 0.85);\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .cam-stick-well.active {\n    border-color: var(--accent);\n    box-shadow:\n      inset 0 5px 14px oklch(0.05 0.01 55 / 0.85),\n      0 0 18px var(--accent-glow);\n  }\n\n  .cam-stick-cap {\n    width: clamp(46px, 13.5dvh, 56px);\n    height: clamp(46px, 13.5dvh, 56px);\n    border-radius: 50%;\n    background:\n      radial-gradient(circle at 36% 32%, oklch(0.34 0.025 55), oklch(0.20 0.018 55) 72%, oklch(0.15 0.014 55) 100%);\n    border: 2px solid var(--border-bright);\n    box-shadow: 0 5px 12px oklch(0.04 0.01 55 / 0.78);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 9px;\n    font-weight: 900;\n    color: var(--ink-secondary);\n    pointer-events: none;\n    will-change: transform;\n  }\n\n  /* DualSense Action Diamond (Triangle, Square, Circle, Cross) */\n  .action-diamond {\n    position: relative;\n    width: 100%;\n    height: 100%;\n    min-height: 170px;\n  }\n\n  .face-btn {\n    position: absolute;\n    border-radius: 50%;\n    background:\n      radial-gradient(circle at 35% 28%, oklch(0.28 0.025 55), oklch(0.18 0.018 55) 75%);\n    border: 2px solid var(--border-bright);\n    box-shadow:\n      0 6px 16px oklch(0.04 0.01 55 / 0.7),\n      inset 0 1.5px 3px oklch(0.98 0.01 80 / 0.22);\n    color: var(--ink-primary);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    line-height: 1.05;\n    transition: transform 90ms var(--ease-out-expo), background 110ms ease, border-color 110ms ease, box-shadow 110ms ease;\n  }\n\n  .face-btn .glyph {\n    font-size: clamp(16px, 4.6dvh, 21px);\n    font-weight: 900;\n  }\n\n  .face-btn .lbl {\n    font-size: clamp(8.5px, 2.2dvh, 10px);\n    font-weight: 800;\n    color: var(--ink-secondary);\n    letter-spacing: 0.02em;\n    margin-top: 1px;\n  }\n\n  /* Cross (Bottom - Primary Largest Jump / Wall-Kick Button) */\n  .face-btn.btn-cross {\n    width: clamp(64px, 18.5dvh, 76px);\n    height: clamp(64px, 18.5dvh, 76px);\n    left: 50%;\n    bottom: 2%;\n    transform: translateX(-50%);\n    background:\n      radial-gradient(circle at 35% 28%, oklch(0.34 0.05 75), oklch(0.21 0.03 65) 78%);\n    border-color: var(--accent);\n    box-shadow:\n      0 6px 18px oklch(0.04 0.01 55 / 0.75),\n      0 0 14px var(--accent-soft);\n  }\n  .face-btn.btn-cross .glyph {\n    color: var(--accent);\n    font-size: clamp(19px, 5.2dvh, 24px);\n  }\n\n  /* Square (Left - Air-Dash / Orb Snap) */\n  .face-btn.btn-square {\n    width: clamp(56px, 16dvh, 66px);\n    height: clamp(56px, 16dvh, 66px);\n    left: 2%;\n    top: 48%;\n    transform: translateY(-50%);\n  }\n  .face-btn.btn-square .glyph {\n    color: var(--cyan-orb);\n  }\n\n  /* Circle (Right - Slide / Long-Jump) */\n  .face-btn.btn-circle {\n    width: clamp(56px, 16dvh, 66px);\n    height: clamp(56px, 16dvh, 66px);\n    right: 2%;\n    top: 48%;\n    transform: translateY(-50%);\n  }\n  .face-btn.btn-circle .glyph {\n    color: oklch(0.80 0.15 45);\n  }\n\n  /* Triangle (Top - Rewind to Shrine) */\n  .face-btn.btn-triangle {\n    width: clamp(50px, 14.5dvh, 58px);\n    height: clamp(50px, 14.5dvh, 58px);\n    left: 50%;\n    top: 2%;\n    transform: translateX(-50%);\n  }\n  .face-btn.btn-triangle .glyph {\n    color: oklch(0.85 0.14 145);\n  }\n\n  /* Active Pressed States for Diamond Buttons */\n  .face-btn.btn-cross.pressed {\n    transform: translateX(-50%) scale(0.92);\n    background: var(--accent);\n    color: var(--ink-dark);\n    box-shadow: 0 0 24px var(--accent);\n  }\n  .face-btn.btn-cross.pressed .glyph,\n  .face-btn.btn-cross.pressed .lbl {\n    color: var(--ink-dark);\n  }\n\n  .face-btn.btn-square.pressed {\n    transform: translateY(-50%) scale(0.92);\n    background: var(--cyan-orb);\n    border-color: var(--ink-primary);\n    box-shadow: 0 0 24px var(--cyan-orb);\n  }\n  .face-btn.btn-square.pressed .glyph,\n  .face-btn.btn-square.pressed .lbl {\n    color: var(--ink-dark);\n  }\n\n  .face-btn.btn-square.orb-hot {\n    border-color: var(--cyan-orb);\n    background: radial-gradient(circle at 50% 50%, oklch(0.36 0.11 210), oklch(0.22 0.08 210));\n    box-shadow: 0 0 22px var(--cyan-glow);\n  }\n\n  .face-btn.btn-circle.pressed {\n    transform: translateY(-50%) scale(0.92);\n    background: oklch(0.80 0.15 45);\n    border-color: var(--ink-primary);\n  }\n  .face-btn.btn-circle.pressed .glyph,\n  .face-btn.btn-circle.pressed .lbl {\n    color: var(--ink-dark);\n  }\n\n  .face-btn.btn-triangle.pressed {\n    transform: translateX(-50%) scale(0.92);\n    background: oklch(0.85 0.14 145);\n    border-color: var(--ink-primary);\n  }\n  .face-btn.btn-triangle.pressed .glyph,\n  .face-btn.btn-triangle.pressed .lbl {\n    color: var(--ink-dark);\n  }\n\n  /* Portrait Rotate Prompt Overlay */\n  .rotate-overlay {\n    position: fixed;\n    inset: 0;\n    background: oklch(0.11 0.014 55 / 0.97);\n    z-index: 50;\n    display: none;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    padding: 28px;\n    text-align: center;\n    gap: 14px;\n  }\n\n  @media (orientation: portrait) {\n    .rotate-overlay:not(.dismissed) {\n      display: flex;\n    }\n  }\n\n  .rotate-icon {\n    width: 72px;\n    height: 44px;\n    border-radius: 12px;\n    border: 2.5px solid var(--accent);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 20px;\n    color: var(--accent);\n    box-shadow: 0 0 24px var(--accent-glow);\n  }\n\n  .rotate-overlay h2 {\n    font-size: 22px;\n    font-weight: 900;\n    text-wrap: balance;\n  }\n\n  .rotate-overlay p {\n    font-size: 14px;\n    color: var(--ink-secondary);\n    max-width: 32ch;\n    text-wrap: pretty;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    *, *::before, *::after {\n      transition-duration: 0.01ms !important;\n    }\n  }\n</style>\n</head>\n<body>\n\n<!-- Hidden iOS 17.4 / 18+ Native Taptic Engine Switch Trigger -->\n<div aria-hidden=\"true\" style=\"position:fixed;left:-9999px;top:-9999px;opacity:0;pointer-events:none;\">\n  <input type=\"checkbox\" id=\"ios-haptic-switch\" switch />\n  <label for=\"ios-haptic-switch\" id=\"ios-haptic-label\"></label>\n</div>\n\n<!-- Portrait Orientation Notice (auto-hides when iPhone is rotated horizontally) -->\n<div class=\"rotate-overlay\" id=\"rotate-overlay\">\n  <div class=\"rotate-icon\">\u27f3</div>\n  <h2>Rotate iPhone Horizontally</h2>\n  <p>Solstice Spire's DualSense deck is tailored for landscape grip on iPhone 15.</p>\n  <button type=\"button\" class=\"pill-btn\" id=\"dismiss-rotate-btn\" style=\"margin-top:8px;padding:0 20px;height:44px;\">\n    Use Current Orientation\n  </button>\n</div>\n\n<main class=\"controller-deck\" id=\"controller-deck\">\n  <!-- ================= LEFT WING ================= -->\n  <section class=\"wing-left\" aria-label=\"Movement Controls\">\n    <div class=\"shoulder-row\">\n      <div class=\"trigger-btn\" id=\"btn-l2\" role=\"button\" aria-label=\"L2 Slide Dive\">\n        <span class=\"tag\">L2</span>\n        <span>SLIDE</span>\n      </div>\n      <div class=\"trigger-btn\" id=\"btn-l1\" role=\"button\" aria-label=\"L1 Sprint Lock\">\n        <span class=\"tag\">L1</span>\n        <span id=\"l1-label\">SPRINT</span>\n      </div>\n    </div>\n\n    <div class=\"stick-stage\" id=\"left-stick-zone\">\n      <div class=\"stick-well\" id=\"left-stick-well\">\n        <div class=\"stick-axis-cross\"></div>\n        <div class=\"stick-cap\" id=\"left-stick-cap\">\n          <div class=\"stick-cap-inner\" id=\"left-stick-readout\">L3</div>\n        </div>\n        <div class=\"stick-badge\" id=\"left-stick-badge\">MOVE \u00b7 OUTER SPRINT</div>\n      </div>\n    </div>\n\n    <div class=\"explorer-bar\" role=\"group\" aria-label=\"Switch Explorer\">\n      <div class=\"explorer-chip active\" data-char=\"pip\" id=\"char-pip\" role=\"button\">\n        <span class=\"dot\" style=\"background:#f9bd3d;\"></span>\n        <span>Pip</span>\n      </div>\n      <div class=\"explorer-chip\" data-char=\"koko\" id=\"char-koko\" role=\"button\">\n        <span class=\"dot\" style=\"background:#47e8ff;\"></span>\n        <span>Koko</span>\n      </div>\n      <div class=\"explorer-chip\" data-char=\"vesper\" id=\"char-vesper\" role=\"button\">\n        <span class=\"dot\" style=\"background:#d68aff;\"></span>\n        <span>Vesper</span>\n      </div>\n    </div>\n  </section>\n\n  <!-- ================= CENTER WING ================= -->\n  <section class=\"wing-center\" aria-label=\"Telemetry Touchpad and System Controls\">\n    <div class=\"utility-row\">\n      <div class=\"pill-btn\" id=\"btn-rewind-top\" role=\"button\" aria-label=\"Rewind to Shrine\">\n        <span>\u27f2</span>\n        <span>Shrine</span>\n      </div>\n      <div class=\"status-capsule\" id=\"status-capsule\">\n        <span class=\"status-dot\" id=\"status-dot\"></span>\n        <span id=\"status-text\">Connecting\u2026</span>\n      </div>\n      <div class=\"pill-btn\" id=\"btn-gyro\" role=\"button\" aria-label=\"Toggle Gyro Aim\">\n        <span>\u25ce</span>\n        <span id=\"gyro-text\">Gyro</span>\n      </div>\n      <div class=\"pill-btn\" id=\"btn-pause\" role=\"button\" aria-label=\"Pause Menu\">\n        <span>\u2261</span>\n        <span>Menu</span>\n      </div>\n    </div>\n\n    <!-- DualSense Center Touchpad (Swipe to Look + Live Telemetry + Context Menu) -->\n    <div class=\"touchpad-shell\" id=\"touchpad-zone\">\n      <div class=\"tp-header\">\n        <span class=\"realm-badge\" id=\"tp-realm-badge\">REALM I</span>\n        <span class=\"realm-title\" id=\"tp-realm-name\">The Sunken Conservatory</span>\n      </div>\n\n      <div class=\"tp-altitude-block\">\n        <div class=\"tp-alt-row\">\n          <span class=\"tp-alt-val\" id=\"tp-alt-val\">0m</span>\n          <span class=\"tp-alt-goal\">/ 1,085m</span>\n        </div>\n        <div class=\"tp-progress-track\">\n          <div class=\"tp-progress-fill\" id=\"tp-progress-fill\"></div>\n        </div>\n      </div>\n\n      <div class=\"tp-metrics\">\n        <span id=\"tp-timer\">00:00.00</span>\n        <span class=\"shard-count\" id=\"tp-shards\">\u2726 0/18</span>\n        <span id=\"tp-flow\">FLOW x0</span>\n      </div>\n\n      <div class=\"tp-hint\" id=\"tp-hint\">SWIPE TOUCHPAD OR RIGHT STICK TO ORBIT CAMERA</div>\n\n      <!-- Context Drawer: Title Screen Mode -->\n      <div class=\"tp-context-drawer visible\" id=\"drawer-title\">\n        <div style=\"text-align:center;\">\n          <div style=\"font-size:10px;font-weight:800;color:var(--ink-secondary);\">TITLE DIORAMA READY</div>\n          <div style=\"font-size:13px;font-weight:900;color:var(--ink-primary);\">Pick Explorer &amp; Launch</div>\n        </div>\n        <button type=\"button\" class=\"cta-primary\" id=\"btn-begin-ascent\">\n          <span>BEGIN ASCENT</span>\n          <span>\u2715</span>\n        </button>\n      </div>\n\n      <!-- Context Drawer: Pause Menu Mode -->\n      <div class=\"tp-context-drawer\" id=\"drawer-pause\">\n        <div style=\"display:flex;gap:6px;\">\n          <button type=\"button\" class=\"cta-primary\" id=\"btn-resume-ascent\" style=\"max-height:38px;min-block-size:38px;font-size:12px;\">\n            <span>RESUME ASCENT</span>\n          </button>\n          <button type=\"button\" class=\"pill-btn\" id=\"btn-restart-climb\" style=\"height:38px;min-block-size:38px;\">\n            <span>Restart</span>\n          </button>\n        </div>\n        <div class=\"realm-mini-grid\" id=\"realm-mini-grid\">\n          <button type=\"button\" class=\"realm-mini-btn\" data-world=\"0\">I \u00b7 Garden</button>\n          <button type=\"button\" class=\"realm-mini-btn\" data-world=\"1\">II \u00b7 Foundry</button>\n          <button type=\"button\" class=\"realm-mini-btn\" data-world=\"2\">III \u00b7 Monsoon</button>\n          <button type=\"button\" class=\"realm-mini-btn\" data-world=\"3\">IV \u00b7 Mirrors</button>\n          <button type=\"button\" class=\"realm-mini-btn\" data-world=\"4\">V \u00b7 Library</button>\n          <button type=\"button\" class=\"realm-mini-btn\" data-world=\"5\">VI \u00b7 Crown</button>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"dualsense-grille\">\n      <div class=\"grille-dots\"><span></span><span></span><span></span><span></span></div>\n      <div class=\"haptic-led\" id=\"haptic-led\"></div>\n      <div class=\"grille-dots\"><span></span><span></span><span></span><span></span></div>\n    </div>\n  </section>\n\n  <!-- ================= RIGHT WING ================= -->\n  <section class=\"wing-right\" aria-label=\"Camera and Parkour Actions\">\n    <div class=\"shoulder-row right-shoulders\">\n      <div class=\"trigger-btn\" id=\"btn-r1\" role=\"button\" aria-label=\"R1 Jump and Wall Kick\">\n        <span class=\"tag\">R1</span>\n        <span>JUMP</span>\n      </div>\n      <div class=\"trigger-btn\" id=\"btn-r2\" role=\"button\" aria-label=\"R2 Air Dash and Orb Snap\">\n        <span class=\"tag\">R2</span>\n        <span id=\"r2-label\">AIR-DASH</span>\n      </div>\n    </div>\n\n    <div class=\"right-deck-body\" id=\"right-look-zone\">\n      <!-- Right Analog Camera Stick -->\n      <div class=\"cam-stick-wrap\" id=\"right-stick-zone\">\n        <div class=\"cam-stick-well\" id=\"right-stick-well\">\n          <div class=\"stick-axis-cross\"></div>\n          <div class=\"cam-stick-cap\" id=\"right-stick-cap\">CAM</div>\n        </div>\n      </div>\n\n      <!-- DualSense Parkour Action Diamond -->\n      <div class=\"action-diamond\">\n        <div class=\"face-btn btn-triangle\" id=\"btn-triangle\" role=\"button\" aria-label=\"Triangle Rewind to Shrine\">\n          <span class=\"glyph\">\u25b3</span>\n          <span class=\"lbl\">SHRINE</span>\n        </div>\n        <div class=\"face-btn btn-square\" id=\"btn-square\" role=\"button\" aria-label=\"Square Air Dash or Orb Snap\">\n          <span class=\"glyph\">\u25a1</span>\n          <span class=\"lbl\" id=\"square-lbl\">DASH</span>\n        </div>\n        <div class=\"face-btn btn-circle\" id=\"btn-circle\" role=\"button\" aria-label=\"Circle Slide Dive\">\n          <span class=\"glyph\">\u25cb</span>\n          <span class=\"lbl\">SLIDE</span>\n        </div>\n        <div class=\"face-btn btn-cross\" id=\"btn-cross\" role=\"button\" aria-label=\"Cross Jump and Wall Kick\">\n          <span class=\"glyph\">\u2715</span>\n          <span class=\"lbl\">JUMP</span>\n        </div>\n      </div>\n    </div>\n  </section>\n</main>\n\n<script>\n(() => {\n  'use strict';\n\n  // --- Character Themes (OKLCH) ---\n  const CHAR_THEMES = {\n    pip: {\n      accent: 'oklch(0.81 0.16 78)',\n      glow: 'oklch(0.81 0.16 78 / 0.38)',\n      soft: 'oklch(0.81 0.16 78 / 0.16)'\n    },\n    koko: {\n      accent: 'oklch(0.85 0.15 210)',\n      glow: 'oklch(0.85 0.15 210 / 0.38)',\n      soft: 'oklch(0.85 0.15 210 / 0.16)'\n    },\n    vesper: {\n      accent: 'oklch(0.78 0.17 312)',\n      glow: 'oklch(0.78 0.17 312 / 0.38)',\n      soft: 'oklch(0.78 0.17 312 / 0.16)'\n    }\n  };\n\n  // --- Triple-Layer Haptic & Tactile Acoustic Synthesizer ---\n  const hapticLabel = document.getElementById('ios-haptic-label');\n  const hapticLed = document.getElementById('haptic-led');\n  let audioCtx = null;\n\n  function ensureAudio() {\n    if (!audioCtx) {\n      const AC = window.AudioContext || window.webkitAudioContext;\n      if (AC) audioCtx = new AC();\n    }\n    if (audioCtx && audioCtx.state === 'suspended') {\n      audioCtx.resume().catch(() => {});\n    }\n  }\n\n  function triggerHaptic(kind = 'tap') {\n    // 1. iOS 17.4 / 18+ Native Taptic Engine Switch click\n    try {\n      if (hapticLabel) hapticLabel.click();\n    } catch (_) {}\n\n    // 2. Standard Vibration API fallback\n    if (navigator.vibrate) {\n      const patterns = {\n        tap: [10],\n        jump: [14],\n        double_jump: [12, 24, 18],\n        dash: [22],\n        tether: [15, 20, 28],\n        slide: [16],\n        wall_kick: [20],\n        land: [18],\n        shard: [12, 30, 20],\n        rewind: [25, 30, 15]\n      };\n      try { navigator.vibrate(patterns[kind] || [10]); } catch (_) {}\n    }\n\n    // 3. Sub-Bass Chassis Resonance + Micro-Switch Transient (Web Audio API)\n    try {\n      ensureAudio();\n      if (audioCtx && audioCtx.state === 'running') {\n        const now = audioCtx.currentTime;\n        const osc = audioCtx.createOscillator();\n        const gain = audioCtx.createGain();\n        osc.connect(gain);\n        gain.connect(audioCtx.destination);\n\n        if (kind === 'dash' || kind === 'tether' || kind === 'wall_kick') {\n          osc.type = 'triangle';\n          osc.frequency.setValueAtTime(115, now);\n          osc.frequency.exponentialRampToValueAtTime(48, now + 0.045);\n          gain.gain.setValueAtTime(0.24, now);\n          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.048);\n          osc.start(now);\n          osc.stop(now + 0.05);\n        } else if (kind === 'shard' || kind === 'double_jump') {\n          osc.type = 'sine';\n          osc.frequency.setValueAtTime(520, now);\n          osc.frequency.exponentialRampToValueAtTime(880, now + 0.055);\n          gain.gain.setValueAtTime(0.12, now);\n          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.06);\n          osc.start(now);\n          osc.stop(now + 0.062);\n        } else {\n          // Physical 64Hz DualSense thump\n          osc.type = 'sine';\n          osc.frequency.setValueAtTime(78, now);\n          osc.frequency.exponentialRampToValueAtTime(44, now + 0.026);\n          gain.gain.setValueAtTime(0.20, now);\n          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.028);\n          osc.start(now);\n          osc.stop(now + 0.03);\n        }\n      }\n    } catch (_) {}\n\n    // Visual LED pulse\n    if (hapticLed) {\n      hapticLed.style.transform = 'scaleX(1.45)';\n      setTimeout(() => { hapticLed.style.transform = 'scaleX(1)'; }, 90);\n    }\n  }\n\n  // --- Controller State ---\n  const state = {\n    mx: 0,\n    my: 0,\n    cx: 0,\n    cy: 0,\n    ldx: 0,\n    ldy: 0,\n    sprint_lock: false,\n    auto_sprint: false,\n    jump: false,\n    dash: false,\n    slide: false,\n    rewind: false,\n    game_mode: 'title', // 'title' | 'playing' | 'paused' | 'victory'\n    selected_char: 'pip',\n    orb_locked: false,\n    gyro_enabled: false\n  };\n\n  // --- WebSocket + HTTP Fallback Transport ---\n  const statusDot = document.getElementById('status-dot');\n  const statusText = document.getElementById('status-text');\n  let ws = null;\n  let wsConnected = false;\n  let lastPingTime = 0;\n  let rttMs = 2;\n\n  function connectWebSocket() {\n    const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';\n    const wsUrl = `${proto}//${location.host}/ws`;\n    try {\n      ws = new WebSocket(wsUrl);\n    } catch (e) {\n      scheduleReconnect();\n      return;\n    }\n\n    ws.onopen = () => {\n      wsConnected = true;\n      statusDot.classList.add('connected');\n      statusText.textContent = `LIVE \u00b7 ${rttMs}ms`;\n      triggerHaptic('shard');\n      sendPacket({ t: 'hello', ua: navigator.userAgent });\n    };\n\n    ws.onmessage = (ev) => {\n      try {\n        const msg = JSON.parse(ev.data);\n        handleServerMessage(msg);\n      } catch (_) {}\n    };\n\n    ws.onclose = () => {\n      wsConnected = false;\n      statusDot.classList.remove('connected');\n      statusText.textContent = 'Reconnecting\u2026';\n      scheduleReconnect();\n    };\n\n    ws.onerror = () => {\n      wsConnected = false;\n    };\n  }\n\n  let reconnectTimer = null;\n  function scheduleReconnect() {\n    if (reconnectTimer) return;\n    reconnectTimer = setTimeout(() => {\n      reconnectTimer = null;\n      connectWebSocket();\n    }, 900);\n  }\n\n  function sendPacket(payload) {\n    const json = JSON.stringify(payload);\n    if (ws && wsConnected && ws.readyState === WebSocket.OPEN) {\n      ws.send(json);\n    } else {\n      // Resilient HTTP fallback if WebSocket is still handshaking\n      fetch('/input', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: json,\n        keepalive: true\n      }).catch(() => {});\n    }\n  }\n\n  // Send continuous 60Hz state stream + immediate edge triggers\n  function transmitState(extraEvent = null) {\n    const payload = {\n      t: 'state',\n      mx: Number(state.mx.toFixed(3)),\n      my: Number(state.my.toFixed(3)),\n      cx: Number(state.cx.toFixed(3)),\n      cy: Number(state.cy.toFixed(3)),\n      ldx: Number(state.ldx.toFixed(2)),\n      ldy: Number(state.ldy.toFixed(2)),\n      sp: (state.sprint_lock || state.auto_sprint) ? 1 : 0,\n      jp: state.jump ? 1 : 0,\n      da: state.dash ? 1 : 0,\n      sl: state.slide ? 1 : 0,\n      rw: state.rewind ? 1 : 0\n    };\n    if (extraEvent) {\n      payload.ev = extraEvent;\n    }\n    state.ldx = 0;\n    state.ldy = 0;\n    sendPacket(payload);\n  }\n\n  function sendCommand(cmd, arg = null) {\n    sendPacket({ t: 'cmd', cmd, arg });\n  }\n\n  // --- Receive Telemetry & Haptic Events from Godot ---\n  const tpRealmBadge = document.getElementById('tp-realm-badge');\n  const tpRealmName = document.getElementById('tp-realm-name');\n  const tpAltVal = document.getElementById('tp-alt-val');\n  const tpProgressFill = document.getElementById('tp-progress-fill');\n  const tpTimer = document.getElementById('tp-timer');\n  const tpShards = document.getElementById('tp-shards');\n  const tpFlow = document.getElementById('tp-flow');\n  const drawerTitle = document.getElementById('drawer-title');\n  const drawerPause = document.getElementById('drawer-pause');\n  const btnSquare = document.getElementById('btn-square');\n  const squareLbl = document.getElementById('square-lbl');\n  const btnR2 = document.getElementById('btn-r2');\n  const r2Label = document.getElementById('r2-label');\n\n  const NUMERALS = ['REALM I', 'REALM II', 'REALM III', 'REALM IV', 'REALM V', 'REALM VI'];\n\n  function applyCharacterTheme(charId) {\n    if (!CHAR_THEMES[charId]) return;\n    state.selected_char = charId;\n    const th = CHAR_THEMES[charId];\n    document.documentElement.style.setProperty('--accent', th.accent);\n    document.documentElement.style.setProperty('--accent-glow', th.glow);\n    document.documentElement.style.setProperty('--accent-soft', th.soft);\n    document.querySelectorAll('.explorer-chip').forEach(el => {\n      el.classList.toggle('active', el.dataset.char === charId);\n    });\n  }\n\n  function handleServerMessage(msg) {\n    if (msg.t === 'pong') {\n      rttMs = Math.max(1, Math.min(99, Date.now() - lastPingTime));\n      if (wsConnected) statusText.textContent = `LIVE \u00b7 ${rttMs}ms`;\n      return;\n    }\n    if (msg.t === 'haptic') {\n      triggerHaptic(msg.kind || 'tap');\n      return;\n    }\n    if (msg.t === 'telemetry') {\n      if (msg.char && msg.char !== state.selected_char) {\n        applyCharacterTheme(msg.char);\n      }\n      if (typeof msg.alt === 'number') {\n        const altInt = Math.round(msg.alt);\n        tpAltVal.textContent = `${altInt}m`;\n        const pct = Math.max(0, Math.min(100, (msg.alt / 1085) * 100));\n        tpProgressFill.style.width = `${pct.toFixed(1)}%`;\n      }\n      if (typeof msg.world === 'number') {\n        tpRealmBadge.textContent = NUMERALS[Math.max(0, Math.min(5, msg.world))];\n      }\n      if (msg.wname) tpRealmName.textContent = msg.wname;\n      if (msg.time) tpTimer.textContent = msg.time;\n      if (typeof msg.shards === 'number') tpShards.textContent = `\u2726 ${msg.shards}/18`;\n      if (typeof msg.streak === 'number') tpFlow.textContent = `FLOW x${msg.streak}`;\n\n      // Orb Lock-on Illumination\n      const orbHot = Boolean(msg.orb);\n      if (orbHot !== state.orb_locked) {\n        state.orb_locked = orbHot;\n        btnSquare.classList.toggle('orb-hot', orbHot);\n        btnR2.classList.toggle('orb-hot', orbHot);\n        squareLbl.textContent = orbHot ? 'SNAP!' : 'DASH';\n        r2Label.textContent = orbHot ? 'SNAP ORB!' : 'AIR-DASH';\n        if (orbHot) triggerHaptic('tap');\n      }\n\n      // Context Mode (title / playing / paused)\n      if (msg.mode && msg.mode !== state.game_mode) {\n        state.game_mode = msg.mode;\n        drawerTitle.classList.toggle('visible', msg.mode === 'title');\n        drawerPause.classList.toggle('visible', msg.mode === 'paused');\n      }\n    }\n  }\n\n  // --- Multi-Touch Left Analog Thumbstick ---\n  const leftZone = document.getElementById('left-stick-zone');\n  const leftWell = document.getElementById('left-stick-well');\n  const leftCap = document.getElementById('left-stick-cap');\n  const leftReadout = document.getElementById('left-stick-readout');\n  const leftBadge = document.getElementById('left-stick-badge');\n  let leftTouchId = null;\n  let leftCenter = { x: 0, y: 0, maxR: 48 };\n\n  function updateLeftStick(clientX, clientY) {\n    const dx = clientX - leftCenter.x;\n    const dy = clientY - leftCenter.y;\n    const dist = Math.hypot(dx, dy);\n    const maxR = leftCenter.maxR;\n    const clampedDist = Math.min(dist, maxR);\n    const angle = Math.atan2(dy, dx);\n    const px = Math.cos(angle) * clampedDist;\n    const py = Math.sin(angle) * clampedDist;\n\n    leftCap.style.transform = `translate3d(${px.toFixed(1)}px, ${py.toFixed(1)}px, 0)`;\n\n    const norm = clampedDist / maxR;\n    if (norm < 0.10) {\n      state.mx = 0;\n      state.my = 0;\n    } else {\n      const rescaled = (norm - 0.10) / 0.90;\n      state.mx = Math.cos(angle) * rescaled;\n      state.my = Math.sin(angle) * rescaled;\n    }\n\n    const wasSprinting = state.auto_sprint;\n    state.auto_sprint = norm > 0.76;\n    if (state.auto_sprint && !wasSprinting) {\n      triggerHaptic('tap');\n    }\n    leftWell.classList.toggle('sprinting', state.auto_sprint || state.sprint_lock);\n    leftReadout.textContent = (state.auto_sprint || state.sprint_lock) ? 'RUN' : 'L3';\n    leftBadge.textContent = (state.auto_sprint || state.sprint_lock) ? 'SPRINT ENGAGED' : 'MOVE \u00b7 OUTER SPRINT';\n  }\n\n  function resetLeftStick() {\n    leftTouchId = null;\n    state.mx = 0;\n    state.my = 0;\n    state.auto_sprint = false;\n    leftCap.style.transform = 'translate3d(0px, 0px, 0)';\n    leftWell.classList.remove('active');\n    leftWell.classList.toggle('sprinting', state.sprint_lock);\n    leftReadout.textContent = state.sprint_lock ? 'RUN' : 'L3';\n    leftBadge.textContent = state.sprint_lock ? 'SPRINT LOCKED' : 'MOVE \u00b7 OUTER SPRINT';\n    transmitState();\n  }\n\n  leftZone.addEventListener('touchstart', (e) => {\n    e.preventDefault();\n    if (leftTouchId !== null) return;\n    const t = e.changedTouches[0];\n    leftTouchId = t.identifier;\n    const rect = leftWell.getBoundingClientRect();\n    leftCenter = {\n      x: rect.left + rect.width * 0.5,\n      y: rect.top + rect.height * 0.5,\n      maxR: rect.width * 0.34\n    };\n    leftWell.classList.add('active');\n    triggerHaptic('tap');\n    updateLeftStick(t.clientX, t.clientY);\n    transmitState();\n  }, { passive: false });\n\n  leftZone.addEventListener('touchmove', (e) => {\n    e.preventDefault();\n    for (let i = 0; i < e.changedTouches.length; i++) {\n      const t = e.changedTouches[i];\n      if (t.identifier === leftTouchId) {\n        updateLeftStick(t.clientX, t.clientY);\n        break;\n      }\n    }\n  }, { passive: false });\n\n  leftZone.addEventListener('touchend', (e) => {\n    for (let i = 0; i < e.changedTouches.length; i++) {\n      if (e.changedTouches[i].identifier === leftTouchId) {\n        resetLeftStick();\n        break;\n      }\n    }\n  });\n  leftZone.addEventListener('touchcancel', resetLeftStick);\n\n  // --- Multi-Touch Right Analog Camera Stick ---\n  const rightZone = document.getElementById('right-stick-zone');\n  const rightWell = document.getElementById('right-stick-well');\n  const rightCap = document.getElementById('right-stick-cap');\n  let rightTouchId = null;\n  let rightCenter = { x: 0, y: 0, maxR: 38 };\n  let rightPrev = { x: 0, y: 0 };\n\n  function updateRightStick(clientX, clientY) {\n    const dx = clientX - rightCenter.x;\n    const dy = clientY - rightCenter.y;\n    const dist = Math.hypot(dx, dy);\n    const maxR = rightCenter.maxR;\n    const clampedDist = Math.min(dist, maxR);\n    const angle = Math.atan2(dy, dx);\n    const px = Math.cos(angle) * clampedDist;\n    const py = Math.sin(angle) * clampedDist;\n\n    rightCap.style.transform = `translate3d(${px.toFixed(1)}px, ${py.toFixed(1)}px, 0)`;\n\n    const norm = clampedDist / maxR;\n    if (norm < 0.10) {\n      state.cx = 0;\n      state.cy = 0;\n    } else {\n      const rescaled = (norm - 0.10) / 0.90;\n      state.cx = Math.cos(angle) * rescaled;\n      state.cy = Math.sin(angle) * rescaled;\n    }\n\n    // Also add responsive micro-trackpad delta on initial movement\n    state.ldx += (clientX - rightPrev.x) * 0.45;\n    state.ldy += (clientY - rightPrev.y) * 0.45;\n    rightPrev = { x: clientX, y: clientY };\n  }\n\n  function resetRightStick() {\n    rightTouchId = null;\n    state.cx = 0;\n    state.cy = 0;\n    rightCap.style.transform = 'translate3d(0px, 0px, 0)';\n    rightWell.classList.remove('active');\n    transmitState();\n  }\n\n  rightZone.addEventListener('touchstart', (e) => {\n    e.preventDefault();\n    e.stopPropagation();\n    if (rightTouchId !== null) return;\n    const t = e.changedTouches[0];\n    rightTouchId = t.identifier;\n    const rect = rightWell.getBoundingClientRect();\n    rightCenter = {\n      x: rect.left + rect.width * 0.5,\n      y: rect.top + rect.height * 0.5,\n      maxR: rect.width * 0.34\n    };\n    rightPrev = { x: t.clientX, y: t.clientY };\n    rightWell.classList.add('active');\n    triggerHaptic('tap');\n    updateRightStick(t.clientX, t.clientY);\n  }, { passive: false });\n\n  rightZone.addEventListener('touchmove', (e) => {\n    e.preventDefault();\n    e.stopPropagation();\n    for (let i = 0; i < e.changedTouches.length; i++) {\n      const t = e.changedTouches[i];\n      if (t.identifier === rightTouchId) {\n        updateRightStick(t.clientX, t.clientY);\n        break;\n      }\n    }\n  }, { passive: false });\n\n  rightZone.addEventListener('touchend', (e) => {\n    for (let i = 0; i < e.changedTouches.length; i++) {\n      if (e.changedTouches[i].identifier === rightTouchId) {\n        resetRightStick();\n        break;\n      }\n    }\n  });\n  rightZone.addEventListener('touchcancel', resetRightStick);\n\n  // --- Touchpad & Action-Button Look-While-Pressing Trackpad ---\n  const touchpadZone = document.getElementById('touchpad-zone');\n  const activeLookTouches = new Map();\n\n  function attachLookTrackpad(element, sensitivity = 1.35) {\n    element.addEventListener('touchstart', (e) => {\n      if (e.target.closest('button')) return;\n      for (let i = 0; i < e.changedTouches.length; i++) {\n        const t = e.changedTouches[i];\n        activeLookTouches.set(t.identifier, { x: t.clientX, y: t.clientY, sens: sensitivity });\n      }\n    }, { passive: true });\n\n    element.addEventListener('touchmove', (e) => {\n      for (let i = 0; i < e.changedTouches.length; i++) {\n        const t = e.changedTouches[i];\n        const prev = activeLookTouches.get(t.identifier);\n        if (prev) {\n          state.ldx += (t.clientX - prev.x) * prev.sens;\n          state.ldy += (t.clientY - prev.y) * prev.sens;\n          prev.x = t.clientX;\n          prev.y = t.clientY;\n        }\n      }\n    }, { passive: true });\n\n    const endTrack = (e) => {\n      for (let i = 0; i < e.changedTouches.length; i++) {\n        activeLookTouches.delete(e.changedTouches[i].identifier);\n      }\n    };\n    element.addEventListener('touchend', endTrack, { passive: true });\n    element.addEventListener('touchcancel', endTrack, { passive: true });\n  }\n\n  attachLookTrackpad(touchpadZone, 1.55);\n  attachLookTrackpad(document.getElementById('right-look-zone'), 1.25);\n\n  // --- Action Buttons with Look-While-Holding & Instant Edge Latching ---\n  function bindHoldButton(el, stateKey, eventName, hapticKind) {\n    let activeTouch = null;\n    let prevPos = null;\n\n    const onDown = (e) => {\n      e.preventDefault();\n      if (activeTouch !== null) return;\n      const t = e.changedTouches ? e.changedTouches[0] : e;\n      activeTouch = t.identifier ?? 'mouse';\n      prevPos = { x: t.clientX, y: t.clientY };\n      state[stateKey] = true;\n      el.classList.add('pressed');\n      triggerHaptic(hapticKind);\n      transmitState(eventName);\n    };\n\n    const onMove = (e) => {\n      if (activeTouch === null || !e.changedTouches) return;\n      for (let i = 0; i < e.changedTouches.length; i++) {\n        const t = e.changedTouches[i];\n        if (t.identifier === activeTouch && prevPos) {\n          // Allow thumb-drag camera orbit while holding Jump/Dash/Slide!\n          state.ldx += (t.clientX - prevPos.x) * 1.15;\n          state.ldy += (t.clientY - prevPos.y) * 1.15;\n          prevPos = { x: t.clientX, y: t.clientY };\n        }\n      }\n    };\n\n    const onUp = (e) => {\n      if (activeTouch === null) return;\n      if (e.changedTouches) {\n        let matched = false;\n        for (let i = 0; i < e.changedTouches.length; i++) {\n          if (e.changedTouches[i].identifier === activeTouch) matched = true;\n        }\n        if (!matched) return;\n      }\n      activeTouch = null;\n      prevPos = null;\n      state[stateKey] = false;\n      el.classList.remove('pressed');\n      transmitState();\n    };\n\n    el.addEventListener('touchstart', onDown, { passive: false });\n    el.addEventListener('touchmove', onMove, { passive: false });\n    el.addEventListener('touchend', onUp);\n    el.addEventListener('touchcancel', onUp);\n    el.addEventListener('mousedown', onDown);\n    window.addEventListener('mouseup', onUp);\n  }\n\n  // Cross (\u2715) & R1 -> Jump / Wall-Kick\n  bindHoldButton(document.getElementById('btn-cross'), 'jump', 'jump_down', 'jump');\n  bindHoldButton(document.getElementById('btn-r1'), 'jump', 'jump_down', 'jump');\n\n  // Square (\u25a1) & R2 -> Air-Dash / Spirit-Orb Snap\n  bindHoldButton(document.getElementById('btn-square'), 'dash', 'dash_down', 'dash');\n  bindHoldButton(document.getElementById('btn-r2'), 'dash', 'dash_down', 'dash');\n\n  // Circle (\u25cb) & L2 -> Slide-Dive / Long-Jump\n  bindHoldButton(document.getElementById('btn-circle'), 'slide', 'slide_down', 'slide');\n  bindHoldButton(document.getElementById('btn-l2'), 'slide', 'slide_down', 'slide');\n\n  // Triangle (\u25b3) & Top Shrine button -> Rewind to Last Shrine\n  bindHoldButton(document.getElementById('btn-triangle'), 'rewind', 'rewind_down', 'rewind');\n  bindHoldButton(document.getElementById('btn-rewind-top'), 'rewind', 'rewind_down', 'rewind');\n\n  // L1 Sprint Toggle/Lock\n  const btnL1 = document.getElementById('btn-l1');\n  const l1Label = document.getElementById('l1-label');\n  btnL1.addEventListener('touchstart', (e) => {\n    e.preventDefault();\n    state.sprint_lock = !state.sprint_lock;\n    btnL1.classList.toggle('locked', state.sprint_lock);\n    l1Label.textContent = state.sprint_lock ? 'SPRINT ON' : 'SPRINT';\n    leftWell.classList.toggle('sprinting', state.sprint_lock || state.auto_sprint);\n    triggerHaptic('tap');\n    transmitState();\n  }, { passive: false });\n\n  // Explorer Quick-Swap Chips (Pip / Koko / Vesper)\n  document.querySelectorAll('.explorer-chip').forEach((chip) => {\n    const pick = (e) => {\n      e.preventDefault();\n      const cid = chip.dataset.char;\n      applyCharacterTheme(cid);\n      triggerHaptic('tap');\n      sendCommand('select_character', cid);\n    };\n    chip.addEventListener('touchstart', pick, { passive: false });\n    chip.addEventListener('click', pick);\n  });\n\n  // Pause Menu Button (\u2261)\n  const btnPause = document.getElementById('btn-pause');\n  const togglePause = (e) => {\n    e.preventDefault();\n    triggerHaptic('tap');\n    sendCommand('toggle_pause');\n  };\n  btnPause.addEventListener('touchstart', togglePause, { passive: false });\n  btnPause.addEventListener('click', togglePause);\n\n  // Title Screen: Begin Ascent CTA\n  const btnBegin = document.getElementById('btn-begin-ascent');\n  const startAscent = (e) => {\n    e.preventDefault();\n    triggerHaptic('shard');\n    sendCommand('begin_ascent');\n  };\n  btnBegin.addEventListener('touchstart', startAscent, { passive: false });\n  btnBegin.addEventListener('click', startAscent);\n\n  // Pause Drawer Actions: Resume, Restart, Realm Fast-Travel\n  const btnResume = document.getElementById('btn-resume-ascent');\n  btnResume.addEventListener('touchstart', (e) => {\n    e.preventDefault();\n    triggerHaptic('tap');\n    sendCommand('resume');\n  }, { passive: false });\n  btnResume.addEventListener('click', () => sendCommand('resume'));\n\n  const btnRestart = document.getElementById('btn-restart-climb');\n  btnRestart.addEventListener('touchstart', (e) => {\n    e.preventDefault();\n    triggerHaptic('rewind');\n    sendCommand('restart_climb');\n  }, { passive: false });\n  btnRestart.addEventListener('click', () => sendCommand('restart_climb'));\n\n  document.querySelectorAll('.realm-mini-btn').forEach((b) => {\n    const tp = (e) => {\n      e.preventDefault();\n      triggerHaptic('dash');\n      sendCommand('teleport_world', Number(b.dataset.world));\n    };\n    b.addEventListener('touchstart', tp, { passive: false });\n    b.addEventListener('click', tp);\n  });\n\n  // Optional Gyroscope Tilt-Aim (works on HTTPS tunnel or permissive contexts)\n  const btnGyro = document.getElementById('btn-gyro');\n  const gyroText = document.getElementById('gyro-text');\n  let lastGamma = null;\n  let lastBeta = null;\n\n  function onDeviceOrientation(e) {\n    if (!state.gyro_enabled || e.gamma === null || e.beta === null) return;\n    if (lastGamma !== null && lastBeta !== null) {\n      const dg = e.gamma - lastGamma;\n      const db = e.beta - lastBeta;\n      if (Math.abs(dg) < 25 && Math.abs(db) < 25) {\n        // Landscape orientation mapping\n        state.ldx += db * 1.4;\n        state.ldy -= dg * 1.1;\n      }\n    }\n    lastGamma = e.gamma;\n    lastBeta = e.beta;\n  }\n\n  btnGyro.addEventListener('click', async () => {\n    triggerHaptic('tap');\n    if (state.gyro_enabled) {\n      state.gyro_enabled = false;\n      btnGyro.classList.remove('active-toggle');\n      gyroText.textContent = 'Gyro';\n      return;\n    }\n    try {\n      if (typeof DeviceOrientationEvent !== 'undefined' &&\n          typeof DeviceOrientationEvent.requestPermission === 'function') {\n        const perm = await DeviceOrientationEvent.requestPermission();\n        if (perm !== 'granted') return;\n      }\n      window.addEventListener('deviceorientation', onDeviceOrientation);\n      state.gyro_enabled = true;\n      lastGamma = null;\n      lastBeta = null;\n      btnGyro.classList.add('active-toggle');\n      gyroText.textContent = 'Gyro On';\n    } catch (_) {}\n  });\n\n  // Dismiss Portrait Overlay manually if Orientation Lock is enabled\n  document.getElementById('dismiss-rotate-btn').addEventListener('click', () => {\n    document.getElementById('rotate-overlay').classList.add('dismissed');\n    triggerHaptic('tap');\n  });\n\n  // 60Hz High-Precision Control Loop + 1.5s Ping Heartbeat\n  setInterval(() => {\n    if (wsConnected || state.mx !== 0 || state.my !== 0 || state.cx !== 0 || state.cy !== 0 || state.ldx !== 0 || state.ldy !== 0) {\n      transmitState();\n    }\n  }, 16);\n\n  setInterval(() => {\n    if (wsConnected) {\n      lastPingTime = Date.now();\n      sendPacket({ t: 'ping' });\n    }\n  }, 1500);\n\n  connectWebSocket();\n})();\n</script>\n</body>\n</html>\n"
