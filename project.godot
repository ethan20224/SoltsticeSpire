; Engine configuration file.
; Solstice Spire - Godot 4.7 Forward+ Configuration

config_version=5

[application]

config/name="Solstice Spire"
config/description="Surreal stylized 3rd-person vertical parkour ascent across six floating worlds."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.png"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
AudioDirector="*res://scripts/autoload/audio_director.gd"
PhoneController="*res://scripts/autoload/phone_controller.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/resizable=false
window/dpi/allow_hidpi=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

